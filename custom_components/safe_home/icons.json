{
  "entity": {
    "alarm_control_panel": {
      "safe_home": {
        "default": "mdi:shield-home",
        "state": {
          "disarmed": "mdi:home-heart",
          "armed_away": "mdi:shield-lock",
          "armed_night": "mdi:shield-moon",
          "arming": "mdi:shield-sync",
          "pending": "mdi:shield-alert-outline",
          "triggered": "mdi:alarm-light"
        }
      }
    },
    "switch": {
      "auto_mode": { "default": "mdi:map-marker-radius", "state": { "off": "mdi:map-marker-off" } },
      "night_auto": { "default": "mdi:weather-night", "state": { "off": "mdi:moon-waning-crescent" } }
    },
    "binary_sensor": {
      "open_sensors": { "default": "mdi:door-closed", "state": { "on": "mdi:door-open" } },
      "siren_active": { "default": "mdi:bullhorn-outline", "state": { "on": "mdi:bullhorn" } }
    }
  },
  "services": {
    "panic": { "service": "mdi:alarm-light" },
    "silence": { "service": "mdi:volume-off" },
    "set_auto_mode": { "service": "mdi:map-marker-radius" }
  }
}
